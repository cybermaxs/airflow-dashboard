# Copy to .env (git-ignored) for `make live`. `make demo` needs none of this.

# Your Airflow 3 metadata DB (Postgres). A read-only user is enough.
AIRFLOW_PG_HOST=my-airflow-db.example.com
AIRFLOW_PG_PORT=5432
AIRFLOW_PG_DB=airflow
AIRFLOW_PG_USER=airflow_readonly

# Password: not here. Export it in your shell: export PGPASSWORD=...

# Airflow 3 web UI, for links to DAGs, runs and task logs (empty = no links)
AIRFLOW_UI_URL=https://airflow.example.com

# Team names by dag_id prefix (kept out of the repo): <prefix>:<team>, comma-separated
AIRFLOW_DAG_TEAMS=fin:Finance,mkt:Marketing,ops:Operations
